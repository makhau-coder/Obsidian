                            "raw": "{\n  \"item_name\": \"Paneer Tikka Masala (Spicy)\",\n  \"item_description\": \"Extra spicy paneer tikka masala.\",\n  \"item_price\": 300.00,\n  \"is_available\": false\n}",
                            "options": { "raw": { "language": "json" } }
