        {
            "name": "Ordered Items",
            "item": [
                {
                    "name": "Create Ordered Item",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 201) {",
                                    "    pm.test('Ordered item created', () => pm.response.to.have.status(201));",
                                    "}"
