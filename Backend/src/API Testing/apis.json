                    }
                }
            ]
        },

        {
            "name": "Orders",
            "item": [
                {
                    "name": "Root - Order Service",
                    "request": {
                        "method": "GET",
                        "url": { "raw": "{{BASE_URL}}/order/", "host": ["{{BASE_URL}}"], "path": ["order", ""] }
                    }
                },
                {
                    "name": "Create Order",
