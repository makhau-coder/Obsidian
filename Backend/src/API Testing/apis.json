                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"restro_id\": \"{{restro_id}}\",\n  \"item_name\": \"Paneer Tikka Masala\",\n  \"item_description\": \"Rich and creamy curry made with paneer, spices, onions, and tomatoes.\",\n  \"item_price\": 280.00,\n  \"is_available\": true\n}",
                            "options": { "raw": { "language": "json" } }
