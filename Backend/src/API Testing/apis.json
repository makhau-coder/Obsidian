{
    "info": {
        "_postman_id": "obsidian-backend-collection",
        "name": "Obsidian Backend API",
        "description": "Complete collection for User, Order, and Restaurant (Restro & Menu) APIs.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        { "key": "BASE_URL",      "value": "http://localhost:5000" },
        { "key": "user_id",       "value": "" },
        { "key": "restro_id",     "value": "" },
        { "key": "item_id",       "value": "" },
        { "key": "order_id",      "value": "" },
        { "key": "order_item_id", "value": "" }
    ],
    "item": [

        {
            "name": "Users",
            "item": [
                {
                    "name": "Root - User Service",
                    "request": {
                        "method": "GET",
                        "url": { "raw": "{{BASE_URL}}/user/", "host": ["{{BASE_URL}}"], "path": ["user", ""] }
                    }
                },
                {
                    "name": "Create User",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 201) {",
                                    "    // user_id is not returned directly; use Get All Users to fetch it",
                                    "    pm.test('User created', () => pm.response.to.have.status(201));",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"user_firstname\": \"Abhay\",\n  \"user_lastname\": \"Chaudhary\",\n  \"user_gender\": \"Male\",\n  \"user_role\": \"CUSTOMER\",\n  \"user_email\": \"test@gmail.com\",\n  \"user_phone\": \"9999999999\",\n  \"user_password\": \"asdfjkl;\"\n}",
                            "options": { "raw": { "language": "json" } }
                        },
                        "url": { "raw": "{{BASE_URL}}/user/createUser", "host": ["{{BASE_URL}}"], "path": ["user", "createUser"] }
                    }
                },
                {
                    "name": "Get All Users",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    const json = pm.response.json();",
                                    "    if (json.users && json.users.length > 0) {",
                                    "        pm.collectionVariables.set('user_id', json.users[0].user_id);",
                                    "        console.log('Captured user_id:', json.users[0].user_id);",
                                    "    }",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "url": { "raw": "{{BASE_URL}}/user/getAllUsers", "host": ["{{BASE_URL}}"], "path": ["user", "getAllUsers"] }
                    }
                },
                {
                    "name": "Get User",
                    "request": {
                        "method": "GET",
                        "url": { "raw": "{{BASE_URL}}/user/getUser/{{user_id}}", "host": ["{{BASE_URL}}"], "path": ["user", "getUser", "{{user_id}}"] }
                    }
                },
                {
                    "name": "Edit User",
                    "request": {
                        "method": "PUT",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"user_firstname\": \"Abhay\",\n  \"user_lastname\": \"Chaudhary\",\n  \"user_gender\": \"MALE\",\n  \"user_role\": \"CUSTOMER\",\n  \"user_email\": \"test@gmail.com\",\n  \"user_phone\": \"9999999999\",\n  \"user_password\": \"newpassword123\"\n}",
                            "options": { "raw": { "language": "json" } }
                        },
                        "url": { "raw": "{{BASE_URL}}/user/editUser/{{user_id}}", "host": ["{{BASE_URL}}"], "path": ["user", "editUser", "{{user_id}}"] }
                    }
                },
                {
                    "name": "Delete User",
                    "request": {
                        "method": "DELETE",
                        "url": { "raw": "{{BASE_URL}}/user/deleteUser/{{user_id}}", "host": ["{{BASE_URL}}"], "path": ["user", "deleteUser", "{{user_id}}"] }
                    }
                }
            ]
        },

